# API de Claude (Anthropic) — el clasificador de intenciones la usa
ANTHROPIC_API_KEY=

# Supabase — correr primero AS_ADMIN_esquema_base_datos.sql y luego
# migrations/002_mejoras_flujo.sql
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# WhatsApp Cloud API (Meta) — se obtienen en Meta for Developers.
#
# OJO: esto es el VALOR POR DEFECTO, para cuando hay un solo negocio.
# Cada negocio puede (y con más de un cliente, debe) tener su propio
# número y token en la tabla 'negocios_credenciales' — ver
# database/008_whatsapp_por_negocio.sql. Lo de acá se usa solo si el
# negocio no tiene su fila cargada.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Elegís vos esta palabra secreta, se la das a Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=elegi-una-palabra-secreta-aca
# App Secret de tu app en Meta for Developers (Configuración básica →
# App Secret, NO es el WHATSAPP_TOKEN). Sin esto el webhook rechaza
# TODOS los mensajes entrantes — es lo que prueba que un POST viene
# realmente de Meta y no de cualquiera que encuentre la URL.
WHATSAPP_APP_SECRET=

# Nombres de las plantillas aprobadas en Meta Business Manager (también
# por negocio en 'negocios_credenciales'; esto es el valor por defecto).
# Hasta que estén aprobadas, dejá esto vacío: cada aviso simplemente no
# se envía y el resto del bot funciona igual.
TEMPLATE_RECORDATORIO_24H=
TEMPLATE_RECORDATORIO_HOY=
TEMPLATE_ALERTA_STOCK=
TEMPLATE_DERIVACION_HUMANO=
TEMPLATE_RESUMEN_SEMANAL=

# Poné "false" para apagar cada procesador (ej. en desarrollo). Todos
# corren cada 5 minutos salvo el resumen semanal, que solo actúa los
# lunes en horario comercial.
RECORDATORIOS_ACTIVOS=true
RESERVAS_ACTIVAS=true
ALERTAS_STOCK_ACTIVAS=true
RESUMEN_SEMANAL_ACTIVO=true

PORT=3000
